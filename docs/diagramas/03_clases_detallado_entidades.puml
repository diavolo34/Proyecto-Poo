@startuml clases_detallado_entidades
' Diagrama de Clases - Modelo Detallado (1/2): clases del negocio
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #F4F8FF
  BorderColor #1E40AF
  ArrowColor #334155
}
hide circle

abstract class "Usuario {abstract}" as Usuario {
  #cedula: String
  #nombre: String
  #clave: String
  #horario: Horario
  #presente: boolean = false
  #asistencias: RegistroAsistencia [0..*]
  --
  +Usuario(cedula: String, nombre: String, clave: String, horario: Horario)
  +{static} crear(rol: String, cedula: String, nombre: String, clave: String, horario: Horario): Usuario
  +{abstract} getRol(): String
  +marcarEntrada(): RegistroAsistencia
  +marcarSalida(): RegistroAsistencia
  +estaPresente(): boolean
  +getAsistenciaDeHoy(): RegistroAsistencia
  +getUltimaAsistencia(): RegistroAsistencia
  +trabajaHoy(): boolean
  +verificarClave(clave: String): boolean
  +copiarAsistenciaDe(otro: Usuario): void
  +agregarAsistencia(registro: RegistroAsistencia): void
  +{static} validarNombre(nombre: String): String
  +{static} validarClave(clave: String): void
  +toJson(detalle: boolean): String
  #datosExtraJson(): String
  .. getters y setters ..
  +getCedula(): String
  +setCedula(cedula: String): void
  +getNombre(): String
  +setNombre(nombre: String): void
  +setClave(clave: String): void
  +getHorario(): Horario
  +setHorario(horario: Horario): void
  +setPresente(presente: boolean): void
  +getAsistencias(): RegistroAsistencia [0..*]
}

class Empleado {
  -supervisor: Supervisor
  --
  +Empleado(cedula: String, nombre: String, clave: String, horario: Horario)
  +getRol(): String
  +getSupervisor(): Supervisor
  +setSupervisor(nuevo: Supervisor): void
  #datosExtraJson(): String
}

class Supervisor {
  -empleadosACargo: Empleado [0..*]
  --
  +Supervisor(cedula: String, nombre: String, clave: String, horario: Horario)
  +getRol(): String
  ~agregarEmpleado(empleado: Empleado): void
  ~quitarEmpleado(empleado: Empleado): void
  +verEmpleadosACargo(): Empleado [0..*]
  +consultarAsistencia(empleado: Empleado): RegistroAsistencia [0..*]
  +contarPresentes(): int
  #datosExtraJson(): String
}

class Jefe {
  -empresa: Empresa
  --
  +Jefe(cedula: String, nombre: String, clave: String, horario: Horario)
  +getRol(): String
  ~setEmpresa(empresa: Empresa): void
  +registrarUsuario(datos: Map<String,String>): Usuario
  +modificarUsuario(cedula: String, datos: Map<String,String>): Usuario
  +eliminarUsuario(cedula: String): void
  +asignarSupervisor(empleado: Empleado, cedulaSupervisor: String): void
  -cambiarRol(anterior: Usuario, rol: String): Usuario
  -buscarGestionable(cedula: String): Usuario
  -verificarRolGestionable(rol: String): void
}

class Horario {
  +{static} TOLERANCIA_MINUTOS: int = 10
  -dias: String
  -horaEntrada: LocalTime
  -horaSalida: LocalTime
  --
  +Horario(dias: String, horaEntrada: LocalTime, horaSalida: LocalTime)
  +{static} desdeTexto(dias: String, horaEntrada: String, horaSalida: String): Horario
  +incluyeDia(dia: DayOfWeek): boolean
  +esLlegadaTarde(hora: LocalTime): boolean
  +getDias(): String
  +setDias(dias: String): void
  +getHoraEntrada(): LocalTime
  +getHoraSalida(): LocalTime
  +setHoras(horaEntrada: LocalTime, horaSalida: LocalTime): void
  +toJson(): String
}

class RegistroAsistencia {
  -fecha: LocalDate
  -horaEntrada: LocalTime
  -horaSalida: LocalTime
  -tarde: boolean
  --
  +RegistroAsistencia(fecha: LocalDate, horaEntrada: LocalTime, tarde: boolean)
  +registrarSalida(hora: LocalTime): void
  +estaAbierto(): boolean
  +getFecha(): LocalDate
  +getHoraEntrada(): LocalTime
  +getHoraSalida(): LocalTime
  +isTarde(): boolean
  +toJson(): String
}

class Empresa {
  -nombre: String
  -usuarios: Map<String, Usuario>
  --
  +Empresa(nombre: String)
  +agregarUsuario(usuario: Usuario): void
  +buscarUsuario(cedula: String): Usuario
  +existeCedula(cedula: String): boolean
  +eliminarUsuario(cedula: String): void
  +listarUsuarios(): Usuario [0..*]
  +autenticar(cedula: String, clave: String): Usuario
  +contarPresentes(): int
  +getNombre(): String
}

Empresa "1" o-- "0..*" Usuario : registra >
Usuario "1" *-- "1" Horario : tiene >
Usuario "1" *-- "0..*" RegistroAsistencia : registra >
Usuario <|-- Empleado
Usuario <|-- Supervisor
Usuario <|-- Jefe
Supervisor "0..1" -- "0..*" Empleado : supervisa >
Jefe "1..*" -- "1" Empresa : administra >
@enduml
