@startuml clases_dominio
' Diagrama de Clases - Modelo de Dominio (solo nombres, relaciones, roles y cardinalidad)
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam backgroundColor white
skinparam class {
  BackgroundColor #F4F8FF
  BorderColor #1E40AF
  ArrowColor #334155
}
hide members
hide circle

class Empresa
abstract class "Usuario\n{abstract}" as Usuario
class Empleado
class Supervisor
class Jefe
class Horario
class RegistroAsistencia
class Chatbot

' Agregación: los usuarios existen aunque se elimine la empresa
Empresa "1" o-- "0..*" Usuario : registra >

' Composición: el horario y la asistencia no existen sin su usuario
Usuario "1" *-- "1" Horario : tiene >
Usuario "1" *-- "0..*" RegistroAsistencia : registra >

' Generalización / Especialización ("es un")
Usuario <|-- Empleado
Usuario <|-- Supervisor
Usuario <|-- Jefe

' Asociaciones
Supervisor "0..1" -- "0..*" Empleado : supervisa >
Jefe "1..*" -- "1" Empresa : administra >
Chatbot "0..*" -- "0..1" Usuario : atiende >
@enduml
