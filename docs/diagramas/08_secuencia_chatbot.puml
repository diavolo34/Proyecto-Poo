@startuml secuencia_chatbot
title Caso de uso: Consultar chatbot (actor: Visitante y, con sesión, Empleado / Supervisor / Jefe)
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor white
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam sequence {
  LifeLineBorderColor #64748B
  ParticipantBackgroundColor #F4F8FF
  ParticipantBorderColor #1E40AF
  ActorBackgroundColor #DBEAFE
  ActorBorderColor #1E3A8A
  GroupBorderColor #1E40AF
}

actor Visitante as Actor
participant ":InterfazWeb" as UI
participant "bot:Chatbot" as BOT
participant ":Api" as API
participant ":ControladorApi" as CTRL

Actor -> UI : escribe la pregunta y pulsa Enviar
activate UI
UI -> BOT : responder(mensaje)
activate BOT
BOT -> BOT : normalizar texto (minúsculas, sin acentos)

alt pide marcar entrada o salida
  alt no hay sesión iniciada
    BOT --> UI : "Primero inicia sesión para marcar tu entrada."
  else hay sesión
    BOT -> BOT : marcar(tipo)
    BOT -> API : marcarEntrada() / marcarSalida()
    activate API
    API -> CTRL : handle(POST /api/asistencia/...)
    activate CTRL
    note right of CTRL : ver diagrama de secuencia\n"Marcar entrada"
    CTRL --> API : {mensaje, usuario}
    deactivate CTRL
    API --> BOT : respuesta
    deactivate API
    BOT -> UI : recargar()
    BOT --> UI : "Entrada registrada a las ..."
  end
else pregunta por el personal: presentes, tarde, ausentes o total (punto de extensión: consulta de personal)
  alt rol = Supervisor o Jefe
    BOT -> BOT : consultarPersonal(consulta)
    BOT -> API : listarUsuarios()
    activate API
    API -> CTRL : handle(GET /api/usuarios)
    activate CTRL
    CTRL --> API : [personal según el rol]
    deactivate CTRL
    API --> BOT : personal
    deactivate API
    loop mientras existan personas en la lista
      BOT -> BOT : filtrar por presente / asistenciaHoy.tarde / trabajaHoy
    end
    BOT --> UI : lista de nombres
  else sin sesión o rol = Empleado
    BOT --> UI : "Esa consulta es solo para supervisores y jefes."
  end
else pregunta frecuente (nómina, permisos, seguridad, horario de oficina, contacto, registro)
  BOT --> UI : respuesta predefinida
else no reconoce la pregunta
  BOT --> UI : "No entendí tu pregunta..."
end
deactivate BOT
UI -> UI : agregar(respuesta, false)
UI --> Actor : burbuja con la respuesta y botones sugeridos
deactivate UI
@enduml
