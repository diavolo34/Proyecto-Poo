@startuml casos_de_uso
' Diagrama de Casos de Uso - ConstruTrack
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam backgroundColor white
skinparam packageStyle rectangle
skinparam nodesep 25
skinparam ranksep 60
skinparam usecase {
  BackgroundColor #F4F8FF
  BorderColor #1E40AF
  ArrowColor #334155
}
skinparam actor {
  BorderColor #1E3A8A
  BackgroundColor #DBEAFE
}
left to right direction

actor "Visitante" as Visitante
actor "Empleado" as Empleado
actor "Supervisor" as Supervisor
actor "Jefe" as Jefe

rectangle "Sistema ConstruTrack - Gestión de Personal en Obra" {
  usecase "Consultar información\nde la empresa" as UC_Info
  usecase "Consultar chatbot\n--\npunto de extensión:\nconsulta de personal" as UC_Chat

  usecase "Marcar entrada" as UC_Entrada
  usecase "Marcar salida" as UC_Salida
  usecase "Consultar mi horario\ne historial" as UC_MiHorario
  usecase "Verificar puntualidad" as UC_Puntual
  usecase "Iniciar sesión" as UC_Login

  usecase "Supervisar empleados\n--\npunto de extensión:\nver historial" as UC_Supervisar
  usecase "Consultar asistencia\nde un empleado" as UC_Asistencia

  usecase "Registrar usuario\n--\npunto de extensión:\nrol = Empleado" as UC_Registrar
  usecase "Modificar usuario\n--\npunto de extensión:\nrol = Empleado" as UC_Modificar
  usecase "Eliminar usuario\n--\npunto de extensión:\nes Supervisor" as UC_Eliminar
  usecase "Validar datos\ndel usuario" as UC_Validar
  usecase "Asignar supervisor" as UC_Asignar
  usecase "Liberar empleados\na cargo" as UC_Liberar
}

' Generalización entre actores: cada rol hereda los casos de uso del anterior
' (el Jefe también supervisa: ve la asistencia de todo el personal)
Visitante <|-[norank]- Empleado
Empleado <|-[norank]- Supervisor
Supervisor <|-[norank]- Jefe

' Asociaciones actor - caso de uso
Visitante -- UC_Info
Visitante -- UC_Chat
Empleado -- UC_Entrada
Empleado -- UC_Salida
Empleado -- UC_MiHorario
Supervisor -- UC_Supervisar
Jefe -- UC_Registrar
Jefe -- UC_Modificar
Jefe -- UC_Eliminar

' Inclusiones (obligatorias)
UC_Entrada ..> UC_Login : <<include>>
UC_Salida ..> UC_Login : <<include>>
UC_MiHorario ..> UC_Login : <<include>>
UC_Supervisar ..> UC_Login : <<include>>
UC_Entrada ..> UC_Puntual : <<include>>
UC_Registrar ..> UC_Validar : <<include>>
UC_Modificar ..> UC_Validar : <<include>>

' Extensiones (opcionales, apuntan al caso de uso base)
UC_Supervisar <.. UC_Asistencia : <<extend>>\n{ver historial}
UC_Chat <.. UC_Asistencia : <<extend>>\n{consulta de personal}
UC_Registrar <.. UC_Asignar : <<extend>>\n{rol = Empleado}
UC_Modificar <.. UC_Asignar : <<extend>>\n{rol = Empleado}
UC_Eliminar <.. UC_Liberar : <<extend>>\n{es Supervisor}
@enduml
