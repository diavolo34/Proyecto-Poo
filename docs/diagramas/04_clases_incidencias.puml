@startuml clases_incidencias
!include estilo.iuml
title Diagrama de Clases Detallado (2/4) · Incidencias

abstract class Incidencia {
  - id : int
  - desde : LocalDate
  - hasta : LocalDate
  - descripcion : String
  - fechaReporte : LocalDateTime
  - estado : EstadoIncidencia = PENDIENTE
  - comentarioRevision : String = ""
  # Incidencia(datos : DatosIncidencia)
  + {abstract} getCodigoTipo() : String
  + {abstract} getNombreTipo() : String
  + {abstract} getGravedad() : Gravedad
  + getExtras() : Map<String,String>
  + getDetalle() : String
  + registrarRevision(nuevo : EstadoIncidencia, quien : Usuario, comentario : String, ahora : LocalDateTime) : void
  + cubre(fecha : LocalDate) : boolean
  # aprobadaYCubre(fecha : LocalDate) : boolean
  + horasSinResolver(ahora : LocalDateTime) : long
}
interface Justificable {
  + justificaAusenciaEl(fecha : LocalDate) : boolean
}
class ReposoMedico {
  + {static} CODIGO : String = "REPOSO_MEDICO"
  - centroMedico : String
  - certificado : String
}
class PermisoPersonal {
  + {static} CODIGO : String = "PERMISO_PERSONAL"
}
class AccidenteLaboral {
  + {static} CODIGO : String = "ACCIDENTE_LABORAL"
  - lugar : String
  - requirioAtencion : boolean
}
class Retardo {
  + {static} CODIGO : String = "RETARDO"
  - minutos : int
}
class Ausencia {
  + {static} CODIGO : String = "AUSENCIA"
}
enum EstadoIncidencia {
  PENDIENTE
  EN_REVISION
  APROBADA
  RECHAZADA
  + siguientes() : Set<EstadoIncidencia>
  + puedePasarA(otro : EstadoIncidencia) : boolean
  + esFinal() : boolean
}
enum Gravedad {
  BAJA
  MEDIA
  ALTA
}
class DatosIncidencia <<parámetros>> {
  ~ id : int
  ~ afectado : Usuario
  ~ reportadoPor : Usuario
  ~ desde : LocalDate
  ~ hasta : LocalDate
  ~ descripcion : String
  + extra(clave : String) : String
}
class FabricaIncidencias {
  - creadores : Map<String, Function<DatosIncidencia,Incidencia>>
  + {static} conTiposPorDefecto() : FabricaIncidencias
  + registrar(codigo : String, nombre : String, creador : Function<DatosIncidencia,Incidencia>) : FabricaIncidencias
  + crear(codigo : String, datos : DatosIncidencia) : Incidencia
  + tipos() : Map<String,String>
}
class Usuario
interface RevisorIncidencias

Incidencia <|-- ReposoMedico
Incidencia <|-- PermisoPersonal
Incidencia <|-- AccidenteLaboral
Incidencia <|-- Retardo
Incidencia <|-- Ausencia
Justificable <|.. ReposoMedico
Justificable <|.. PermisoPersonal
Justificable <|.. AccidenteLaboral
Incidencia --> EstadoIncidencia
Incidencia ..> Gravedad
Incidencia "0..*" --> "1" Usuario : afectado
Incidencia "0..*" --> "0..1" Usuario : revisor
FabricaIncidencias ..> DatosIncidencia
FabricaIncidencias ..> Incidencia : <<create>>
RevisorIncidencias ..> Incidencia : revisa
@enduml
