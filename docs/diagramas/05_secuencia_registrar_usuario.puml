@startuml secuencia_registrar_usuario
title Caso de uso: Registrar usuario (actor: Jefe)
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor white
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam sequence {
  LifeLineBorderColor #64748B
  ParticipantBackgroundColor #F4F8FF
  ParticipantBorderColor #1E40AF
  ActorBackgroundColor #DBEAFE
  ActorBorderColor #1E3A8A
  GroupBorderColor #1E40AF
}
autoactivate off

actor Jefe as Actor
participant ":InterfazWeb" as UI
participant ":Api" as API
participant ":ControladorApi" as CTRL
participant ":GestorSesiones" as SES
participant "j:Jefe" as J
participant "emp:Empresa" as EMP
participant "s:Supervisor" as SUP
participant ":BaseDatos" as BD

Actor -> UI : abrirFormulario(null)
activate UI
Actor -> UI : guardarFormulario(form)
UI -> API : registrarUsuario(datos)
activate API
API -> CTRL : handle(POST /api/usuarios, datos)
activate CTRL
CTRL -> SES : obtenerUsuario(token, emp)
activate SES
SES --> CTRL : j
deactivate SES
CTRL -> CTRL : comoJefe(j)

CTRL -> J : registrarUsuario(datos)
activate J
J -> EMP : existeCedula(cedula)
activate EMP
EMP --> J : existe
deactivate EMP

alt existe = true
  J --> CTRL : IllegalStateException("Ya existe un usuario...")
  CTRL --> API : 409 {error}
  API --> UI : Error(mensaje)
  UI --> Actor : muestra el error en el formulario
else existe = false
  create participant "h:Horario" as H
  J -> H : <<create>> desdeTexto(dias, horaEntrada, horaSalida)
  activate H
  H --> J : h
  deactivate H

  alt datos inválidos (cédula, nombre, clave u horas)
    J --> CTRL : IllegalArgumentException(mensaje)
    CTRL --> API : 400 {error}
    API --> UI : Error(mensaje)
    UI --> Actor : muestra el error en el formulario
  else datos válidos
    create participant "nuevo:Empleado" as E
    J -> E : <<create>> Empleado(cedula, nombre, clave, h)
    note right of E : se crea con Usuario.crear(rol, ...)\nsegún el rol elegido
    opt rol = Empleado y se eligió supervisor
      J -> J : asignarSupervisor(nuevo, cedulaSupervisor)
      J -> EMP : buscarUsuario(cedulaSupervisor)
      activate EMP
      EMP --> J : s
      deactivate EMP
      J -> E : setSupervisor(s)
      activate E
      E -> SUP : agregarEmpleado(nuevo)
      deactivate E
    end
    J -> EMP : agregarUsuario(nuevo)
    opt presente = true
      J -> E : marcarEntrada()
    end
    J --> CTRL : nuevo
    deactivate J
    CTRL -> BD : guardar(emp)
    activate BD
    deactivate BD
    CTRL -> E : toJson(false)
    E --> CTRL : json
    CTRL --> API : 200 {usuario}
    deactivate CTRL
    API --> UI : usuario
    deactivate API
    UI -> UI : aviso("... fue registrado")
    UI -> UI : recargar()
    UI --> Actor : tabla de personal actualizada
  end
end
deactivate UI
@enduml
