@startuml clases_servicio_persistencia
!include estilo.iuml
title Diagrama de Clases Detallado (4/5) · Servicios y persistencia

abstract class ServicioBase {
  # plataforma : Plataforma
  # escritor : EscritorDatos
  # reloj : Clock
  # leer(consulta : Supplier<T>) : T
  # modificar(cambio : Supplier<T>) : T
  # empresaDe(actual : Usuario) : Empresa
}
class Servicios {
  + autenticacion() : ServicioAutenticacion
  + asistencia() : ServicioAsistencia
  + personal() : ServicioPersonal
  + novedades() : ServicioNovedades
  + talento() : ServicioTalento
  + inventario() : ServicioInventario
  + catalogo() : ServicioCatalogo
  + archivos() : ServicioArchivos
  + supervision() : ServicioSupervision
  + registro() : ServicioRegistro
  + invitaciones() : ServicioInvitaciones
}
class ServicioAutenticacion {
  + ingresar(identificador : String, clave : String) : Ingreso
}
class ServicioAsistencia
class ServicioPersonal
class ServicioNovedades {
  - fabrica : FabricaNovedades
  + registrar(...) : Novedad
  + revisar(revisor : Usuario, id : int, nuevo : EstadoNovedad, nota : String) : Novedad
  + listar(actual : Usuario, categoria : Categoria) : List<Novedad>
}
class ServicioSupervision {
  - monitor : MonitorSupervision
  - reportes : Map<String,Reporte>
  - formatos : Map<String,FormateadorReporte>
  + exportar(actual : Usuario, tipo : String, formato : String, periodo : String) : Exportacion
}
class ServicioRegistro {
  + registrar(datos : Map<String,String>) : Cuenta
  + unirse(c : Cuenta, codigo : String) : Usuario
}
class ServicioInvitaciones {
  - notificador : Notificador
}
interface Notificador {
  + enviarInvitacion(i : Invitacion, correo : String) : void
}
class NotificadorConsola
class NotificadorBrevo {
  + NotificadorBrevo(api, clave, remitente, urlSitio)
}
class ServicioObras {
  + crear(actual, datos) : Obra
  + asignar(actual, cedula, codigoObra) : Usuario
}
interface LectorDatos {
  + cargar() : Plataforma
}
interface EscritorDatos {
  + guardar(p : Plataforma) : void
}
class RepositorioTexto {
  - almacen : Almacen
  + RepositorioTexto(almacen : Almacen, datosIniciales : Supplier<Empresa>, fabrica : FabricaNovedades)
}
interface Almacen {
  + leer() : Optional<String>
  + escribir(contenido : String) : void
}
class AlmacenArchivo
class AlmacenUpstash
class RepositorioMemoria
class GeneradorDatosPrueba

ServicioBase <|-- ServicioAutenticacion
ServicioBase <|-- ServicioAsistencia
ServicioBase <|-- ServicioPersonal
ServicioBase <|-- ServicioNovedades
ServicioBase <|-- ServicioTalento
ServicioBase <|-- ServicioInventario
ServicioBase <|-- ServicioArchivos
ServicioBase <|-- ServicioSupervision
ServicioBase <|-- ServicioRegistro
ServicioBase <|-- ServicioInvitaciones
Servicios *-- ServicioAutenticacion
Servicios *-- ServicioNovedades
Servicios *-- ServicioTalento
Servicios *-- ServicioInventario
Servicios *-- ServicioArchivos
ServicioArchivos --> AlmacenArchivos
Servicios *-- ServicioSupervision
Servicios *-- ServicioRegistro
Servicios *-- ServicioInvitaciones
ServicioBase --> EscritorDatos : depende de la abstracción
ServicioInvitaciones --> Notificador
Notificador <|.. NotificadorConsola
Notificador <|.. NotificadorBrevo
ServicioBase <|-- ServicioObras
LectorDatos <|.. RepositorioTexto
EscritorDatos <|.. RepositorioTexto
LectorDatos <|.. RepositorioMemoria
EscritorDatos <|.. RepositorioMemoria
RepositorioTexto ..> GeneradorDatosPrueba : si el almacén está vacío
RepositorioTexto --> Almacen : depende de la abstracción
Almacen <|.. AlmacenArchivo
Almacen <|.. AlmacenUpstash
class ServicioTalento {
  + registrarEgreso(actual : Usuario, cedula : String, datos : Map) : Egreso
  + eliminarFicha(actual : Usuario, id : int) : void
  + expediente(actual : Usuario, id : int) : String
}
class ServicioInventario {
  + crear(actual : Usuario, datos : Map) : Articulo
  + asignar(actual : Usuario, codigo : String, datos : Map) : Asignacion
  + devolver(actual : Usuario, id : int, condicion : String, nota : String) : Asignacion
}
class ServicioArchivos {
  + subir(actual : Usuario, nombre : String, datos : byte[], cedula : String, confidencial : boolean) : ArchivoAdjunto
  + descargar(actual : Usuario, id : String) : Descarga
}
interface AlmacenArchivos {
  + guardar(nombre : String, tipo : String, datos : byte[]) : String
  + leer(id : String) : byte[]
}
class AlmacenArchivosDrive
class AlmacenArchivosCarpeta
AlmacenArchivos <|.. AlmacenArchivosDrive
AlmacenArchivos <|.. AlmacenArchivosCarpeta
@enduml
