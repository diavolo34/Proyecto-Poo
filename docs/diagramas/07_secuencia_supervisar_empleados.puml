@startuml secuencia_supervisar_empleados
title Caso de uso: Supervisar empleados (actor: Supervisor) — extensión: Consultar asistencia de un empleado
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor white
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam sequence {
  LifeLineBorderColor #64748B
  ParticipantBackgroundColor #F4F8FF
  ParticipantBorderColor #1E40AF
  ActorBackgroundColor #DBEAFE
  ActorBorderColor #1E3A8A
  GroupBorderColor #1E40AF
}

actor Supervisor as Actor
participant ":InterfazWeb" as UI
participant ":Api" as API
participant ":ControladorApi" as CTRL
participant ":GestorSesiones" as SES
participant "s:Supervisor" as S
participant "e:Empleado" as E
participant "h:Horario" as H
participant "emp:Empresa" as EMP

Actor -> UI : recargar()
activate UI
UI -> API : listarUsuarios()
activate API
API -> CTRL : handle(GET /api/usuarios)
activate CTRL
CTRL -> SES : obtenerUsuario(token, emp)
activate SES
SES --> CTRL : s
deactivate SES
CTRL -> CTRL : listarUsuarios(s)
CTRL -> S : verEmpleadosACargo()
activate S
S --> CTRL : lista
deactivate S

loop mientras existan empleados a cargo en la lista
  CTRL -> E : toJson(false)
  activate E
  E -> E : estaPresente()
  E -> E : getAsistenciaDeHoy()
  E -> H : incluyeDia(hoy)
  activate H
  H --> E : trabajaHoy
  deactivate H
  E --> CTRL : json del empleado
  deactivate E
end

CTRL --> API : 200 [empleados]
deactivate CTRL
API --> UI : empleados
deactivate API
UI -> UI : panelSupervisor(s)
UI --> Actor : horario, estado (Presente/Ausente)\ne entrada de hoy de cada empleado

opt el supervisor pide "Ver historial" (punto de extensión)
  Actor -> UI : mostrarHistorial(cedula)
  UI -> API : verUsuario(cedula)
  activate API
  API -> CTRL : handle(GET /api/usuarios/{cedula})
  activate CTRL
  CTRL -> EMP : buscarUsuario(cedula)
  activate EMP
  EMP --> CTRL : e
  deactivate EMP
  CTRL -> S : consultarAsistencia(e)
  activate S
  alt e no está en empleadosACargo
    S --> CTRL : SecurityException
    CTRL --> API : 403 {error}
    API --> UI : Error(mensaje)
    UI --> Actor : aviso "Solo puedes consultar a tus empleados"
  else e es su empleado
    S --> CTRL : asistencias
    deactivate S
    CTRL -> E : toJson(true)
    E --> CTRL : json con historial
    CTRL --> API : 200 {usuario}
    deactivate CTRL
    API --> UI : usuario
    deactivate API
    UI --> Actor : ventana con el historial de asistencia
  end
end
deactivate UI
@enduml
