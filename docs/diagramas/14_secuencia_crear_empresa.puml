@startuml secuencia_crear_empresa
!include estilo.iuml
title Secuencia: Un jefe se registra y crea su empresa
autoactivate on
actor "Jefe (nuevo)" as A
participant "cta:Cuenta" as C
participant "plat:Plataforma" as P
participant "emp:Empresa" as E
participant "marta:Jefe" as J

A -> P : verificarNombreDisponible("Constructora Norte")
P --> A
create C
A -> C : <<create>> Cuenta(correo, clave, nombre, apellido, documento, teléfono)
C --> A
A -> P : agregarCuenta(cta)
P --> A
A -> P : fundarEmpresa("Constructora Norte", cta, hoy)
P -> P : existeCedula(documento)
P --> P : false
create E
P -> E : <<create>> crearEmpresa(nombre)
E -> P : registrar(emp)
P --> E
E --> P
create J
P -> J : <<create>> Jefe(documento, nombre, horario de oficina)
J --> P
P -> E : agregarUsuario(marta)
E -> J : setEmpresa(emp)
J --> E
E --> P
P -> J : vincularCuenta(cta)
J -> C : vincular(marta)
C --> J
J --> P
P --> A : marta (entra como Jefe e invita a su equipo)
@enduml
